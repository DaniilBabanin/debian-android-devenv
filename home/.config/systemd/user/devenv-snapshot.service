[Unit]
Description=Snapshot devenv stateful dirs on session shutdown
# Best-effort: only fires on graceful shutdown of the user manager.
# Ungraceful VM kills will not trigger ExecStop — run `devenv snapshot`
# by hand or via cron if you need stronger guarantees.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=%h/.local/bin/devenv snapshot
TimeoutStopSec=120

[Install]
WantedBy=default.target
