#!/usr/bin/env bash
# claude-notify — Claude Code `Notification` hook -> Android notification.
#
# Registered in ~/.claude/settings.json by modules/install-claude.sh; fires
# when Claude blocks waiting for the user (permission prompt, idle). Reads the
# hook JSON on stdin and raises a phone notification via Termux:API, so a
# pocketed/locked phone still tells you Claude needs you.
#
# Requirements (Termux side, not guest): `pkg install termux-api` + the
# Termux:API addon app (same source as Termux — F-Droid/GitHub, never mixed).
# Without them this script is a silent no-op, so the same devenv stays usable
# on VM/PC where there is no Termux at all.
#
# Hook contract: NEVER fail the hook — always exit 0, never block the turn
# (termux-api commands hang forever if the addon app is dead; timeout guards).

TERMUX_BIN=/data/data/com.termux/files/usr/bin

notify="$(command -v termux-notification 2>/dev/null || true)"
[ -z "$notify" ] && [ -x "$TERMUX_BIN/termux-notification" ] && notify="$TERMUX_BIN/termux-notification"
[ -z "$notify" ] && exit 0

# Hook JSON on stdin: {.message, .hook_event_name, ...}. jq missing/garbage -> fallback text.
msg="$(jq -r '.message // empty' 2>/dev/null)"
[ -n "$msg" ] || msg="Claude Code needs attention"

# --id: repeat notifications replace instead of piling up.
# --action: tapping the notification focuses the Termux app.
timeout 5 "$notify" \
    --id claude-code \
    --title "Claude Code" \
    --content "$msg" \
    --priority high \
    --vibrate 200,100,200 \
    --action "am start -n com.termux/com.termux.app.TermuxActivity" \
    >/dev/null 2>&1 || true

exit 0
