#!/usr/bin/env bash
# devenv — dispatcher for the persistent dev environment.
# Usage:
#   devenv init                          re-run init (link dotfiles, etc.)
#   devenv install [mod...]              install named modules; `all` = every module
#   devenv list                          list available modules and installed state
#   devenv doctor                        verify symlinks + tool availability
#   devenv sync                          report drift if home/ is a git repo
#   devenv snapshot                      write a new versioned snapshot under $DEVENV_ROOT/snapshots (keeps 3)
#   devenv snapshots                     list retained snapshot versions (newest first)
#   devenv restore [--rollback[=N]]      restore newest snapshot version (or N back) into $HOME
#   devenv help                          show this

set -euo pipefail
# Resolve through symlinks so this works when invoked via ~/.local/bin/devenv.
__self="${BASH_SOURCE[0]}"
while [ -L "$__self" ]; do __self="$(readlink -f "$__self")"; done
# shellcheck disable=SC1091
source "$(dirname "$__self")/lib.sh"

cmd="${1:-help}"; shift || true

cmd_help() {
    cat <<EOF
devenv — persistent dev environment for Debian-on-Android
root: $DEVENV_ROOT

Commands:
  init                           link dotfiles into \$HOME (idempotent)
  install <mod>...               install one or more modules
                                 use 'all' to install every module
  list                           show modules and which are marked installed
  doctor                         verify symlinks and tool availability
  sync                           if home/ is a git repo, show pending changes
  snapshot                       write a new versioned snapshot under
                                 \$DEVENV_ROOT/snapshots (STATEFUL_DIRS +
                                 ARCHIVE_DIRS + manifests), keeping the 3 newest
  snapshots                      list retained snapshot versions (newest first)
  restore [--rollback[=N]]       reverse of snapshot. Default restores the newest
                                 version; --rollback restores the previous one,
                                 --rollback=N goes back N versions.
  probe [--watch S] [--label L]  sample VM degradation signals (PSI stall, mem
        [--tail [N]] [-- cmd]    low-water, zram, OOM events, shared-mount
                                 latency) and append to metrics/probe.jsonl.
                                 --watch S samples for S seconds; -- cmd runs a
                                 workload and measures until it exits; --tail
                                 shows recent samples. See docs/harden-spec.md.
  watch [--once] [--tail [N]]    adaptive degradation daemon: near-silent when
                                 calm, writes one coalesced episode (+ culprit
                                 process tree) to metrics/episodes.jsonl only
                                 when PSI stall / low-mem / OOM trips. Runs as a
                                 systemd --user service (install-watch module).
                                 --tail shows recent episodes.
  help                           this message

Modules ship in: $DEVENV_MODULES
Snapshots in:    $DEVENV_SNAPSHOTS_DIR
Archives in:     $DEVENV_ARCHIVES
EOF
}

cmd_init() {
    bash "$DEVENV_BIN/init.sh"
}

cmd_list() {
    local mods; mods="$(list_modules)"
    if [ -z "$mods" ]; then warn "no modules in $DEVENV_MODULES"; return; fi
    printf '%-12s  %-10s  %s\n' MODULE STATE SENTINEL
    printf '%-12s  %-10s  %s\n' ------ ----- --------
    local m s
    while IFS= read -r m; do
        if sentinel_check "$m"; then
            s="installed"
        else
            s="-"
        fi
        printf '%-12s  %-10s  %s\n' "$m" "$s" "$(sentinel_path "$m")"
    done <<<"$mods"
}

cmd_install() {
    [ $# -gt 0 ] || die "install: need at least one module (or 'all')"
    local mods=()
    if [ "$1" = "all" ]; then
        # Default order — modules with deps must come after their deps.
        local preferred=(base node python claude claude-plugins watch)
        local available; available="$(list_modules)"
        local m
        for m in "${preferred[@]}"; do
            if grep -qx "$m" <<<"$available"; then mods+=("$m"); fi
        done
        # Append any extras not in the preferred list, in alpha order.
        while IFS= read -r m; do
            local found=0
            local p; for p in "${preferred[@]}"; do [ "$p" = "$m" ] && { found=1; break; }; done
            [ $found -eq 0 ] && mods+=("$m")
        done <<<"$available"
    else
        mods=("$@")
    fi

    log "installing: ${mods[*]}"
    local m; for m in "${mods[@]}"; do run_module "$m"; done
    ok "all done."
}

# True if $1 is one of the names in STATEFUL_DIRS.
_in_stateful() {
    local needle="$1" d
    for d in "${STATEFUL_DIRS[@]}"; do [ "$d" = "$needle" ] && return 0; done
    return 1
}

# True if $1 is the top-level component of any SNAPSHOT_FILES entry — i.e.
# this directory exists in $DEVENV_HOME only as a seed template for files
# managed via _restore_file, not as something to symlink into $HOME.
_is_snapshot_file_root() {
    local needle="$1" rel top
    for rel in "${SNAPSHOT_FILES[@]}"; do
        top="${rel%%/*}"
        [ "$top" = "$needle" ] && return 0
    done
    return 1
}

cmd_doctor() {
    # Avoid iterating literal glob patterns when a match set is empty, and
    # include dotfiles in `*` so we don't need parallel `.foo` patterns.
    shopt -s nullglob dotglob

    local fails=0

    # Snapshot-related checks read the current version dir (newest complete).
    local _cur=""
    _cur="$(_version_at 0 2>/dev/null || true)"
    if [ -n "$_cur" ]; then
        DEVENV_SNAPSHOT_DIR="$_cur"
        DEVENV_ARCHIVES="$_cur"
    fi

    step "symlinks"
    local entry rel src dst
    for entry in "$DEVENV_HOME"/*; do
        [ -e "$entry" ] || continue
        rel="$(basename "$entry")"
        # STATEFUL_DIRS are managed by snapshot/restore, not symlinked.
        if _in_stateful "$rel"; then continue; fi
        # SNAPSHOT_FILES roots (e.g. ~/.claude/) are seed templates only.
        if _is_snapshot_file_root "$rel"; then continue; fi
        src="$DEVENV_HOME/$rel"
        dst="$HOME/$rel"
        if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
            ok "~/$rel"
        else
            warn "~/$rel not linked (run: devenv init)"
            fails=$((fails+1))
        fi
    done

    step "stateful dirs"
    local name
    for name in "${STATEFUL_DIRS[@]}"; do
        if [ -L "$HOME/$name" ]; then
            warn "~/$name is a symlink — should be a real path (run: devenv init && devenv restore)"
            fails=$((fails+1))
        elif [ -e "$HOME/$name" ]; then
            ok "~/$name present (snapshot-managed)"
        else
            warn "~/$name missing — run: devenv restore"
        fi
    done

    step "dispatcher on PATH"
    if have devenv; then ok "devenv: $(command -v devenv)"; else warn "devenv not on PATH"; fails=$((fails+1)); fi

    step "modules"
    local m t
    while IFS= read -r m; do
        case "$m" in
            base)   for t in gcc git curl jq tmux fzf rg; do
                        if have "$t"; then ok "base: $t"; else warn "base: missing $t"; fails=$((fails+1)); fi
                    done ;;
            node)   if have nvm || [ -s "$HOME/.nvm/nvm.sh" ]; then ok "node: nvm present"; else warn "node: nvm missing"; fails=$((fails+1)); fi
                    if have node; then ok "node: $(node --version)"; else warn "node: node missing"; fails=$((fails+1)); fi ;;
            python) for t in python3 pipx uv; do
                        if have "$t"; then ok "python: $t"; else warn "python: missing $t"; fails=$((fails+1)); fi
                    done ;;
            claude) if have claude; then ok "claude: $(claude --version 2>&1 | head -1)"; else warn "claude: missing (run devenv install claude)"; fails=$((fails+1)); fi ;;
            claude-plugins)
                if have claude; then
                    local pcount scount
                    pcount="$(claude plugin list 2>/dev/null | grep -cE '^[[:space:]]*[a-zA-Z0-9_-]+@' || true)"
                    ok "claude-plugins: ${pcount:-0} installed"
                    if [ -d "$HOME/.claude/skills" ]; then
                        scount="$(find "$HOME/.claude/skills" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l || true)"
                    else
                        scount=0
                    fi
                    ok "claude-skills: ${scount:-0} cloned"
                else
                    warn "claude-plugins: claude CLI missing"; fails=$((fails+1))
                fi ;;
            cloudflared)
                if have cloudflared; then
                    ok "cloudflared: $(cloudflared --version 2>&1 | head -1)"
                else
                    warn "cloudflared: missing (run: devenv install cloudflared)"; fails=$((fails+1))
                fi
                if [ -f "$HOME/.ssh/config" ] && grep -qE '^[[:space:]]*Host[[:space:]]+ssh\.babanin\.de([[:space:]]|$)' "$HOME/.ssh/config"; then
                    ok "cloudflared: ~/.ssh/config has Host ssh.babanin.de"
                else
                    warn "cloudflared: ~/.ssh/config missing Host ssh.babanin.de (run: devenv install cloudflared)"; fails=$((fails+1))
                fi
                if [ -f "$HOME/.ssh/id_ed25519" ]; then
                    local _kmode; _kmode="$(stat -c '%a' "$HOME/.ssh/id_ed25519" 2>/dev/null || echo '?')"
                    if [ "$_kmode" = 600 ]; then
                        ok "cloudflared: ~/.ssh/id_ed25519 present (mode 600)"
                    else
                        warn "cloudflared: ~/.ssh/id_ed25519 mode is $_kmode, expected 600 (run: devenv restore, or chmod 600)"; fails=$((fails+1))
                    fi
                else
                    warn "cloudflared: ~/.ssh/id_ed25519 missing — the private key is the access credential (restore it: devenv restore)"; fails=$((fails+1))
                fi
                # DNS: do NOT use `getent` here — it resolves via nsswitch's
                # `resolve` module (systemd-resolved) and succeeds even when
                # /etc/resolv.conf is broken. cloudflared (a Go binary) reads
                # /etc/resolv.conf DIRECTLY, so the real test is whether the
                # resolv.conf nameserver is reachable. A dead one (e.g. the GCE
                # metadata resolver 169.254.169.254) makes cloudflared hang on
                # DNS and ssh time out while getent still "works".
                local _ns
                _ns="$(grep -m1 '^[[:space:]]*nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}')"
                if [ -z "$_ns" ]; then
                    warn "cloudflared: /etc/resolv.conf has no nameserver"; fails=$((fails+1))
                elif timeout 2 bash -c "exec 3<>/dev/tcp/$_ns/53" 2>/dev/null; then
                    ok "cloudflared: resolv.conf nameserver $_ns reachable (cloudflared DNS path OK)"
                else
                    warn "cloudflared: resolv.conf nameserver $_ns UNREACHABLE — cloudflared will hang on DNS even though getent works (run: devenv install cloudflared to repoint at the systemd-resolved stub)"; fails=$((fails+1))
                fi
                # Cloudflare Access: ssh.babanin.de sits behind Zero Trust Access.
                # Without a cached token cloudflared can't complete the SSH banner
                # exchange (ssh reports "Connection timed out during banner
                # exchange"). The token lives in ~/.cloudflared/*-token and does
                # NOT survive a VM rebuild, so this is a soft warn, not a fail.
                # nullglob is set (line ~118), so an unmatched glob vanishes and
                # `ls DIR/*-token` would degrade to `ls DIR` and falsely pass.
                # Collect into an array and test the first element instead.
                local _toks; _toks=("$HOME/.cloudflared"/*-token)
                if [ "${#_toks[@]}" -gt 0 ] && [ -e "${_toks[0]}" ]; then
                    ok "cloudflared: Cloudflare Access token cached"
                else
                    warn "cloudflared: no Cloudflare Access token — run 'cloudflared access login https://ssh.babanin.de' (or configure a service token) before ssh will connect"
                fi ;;
        esac
    done < <(list_modules)

    step "fs perms sanity"
    if [ -L "$HOME/.bashrc" ]; then
        local mode; mode="$(stat -c '%a' "$HOME/.bashrc" 2>/dev/null || echo ?)"
        if [ "$mode" = "?" ]; then warn "cannot stat ~/.bashrc"; else ok ".bashrc mode=$mode"; fi
    fi
    if [ -d "$DEVENV_ROOT" ]; then
        local fstype; fstype="$(stat -f -c '%T' "$DEVENV_ROOT" 2>/dev/null || echo ?)"
        log "devenv root filesystem: $fstype  (FUSE/sdcardfs often ignores chmod — flagged for ssh/gpg)"
    fi

    step "snapshot status"
    if [ -n "$_cur" ]; then
        local _created; _created="$(grep -o '"created"[^,]*' "$_cur/meta" 2>/dev/null | cut -d'"' -f4)"
        ok "snapshot: version $(basename "$_cur") (${_created:-?}); $(_version_count) retained"
    else
        warn "no snapshot yet (run: devenv snapshot)"
    fi

    step "archives"
    local a path mtime
    for a in "${ARCHIVE_DIRS[@]}"; do
        path="$(_archive_path "$a")"
        if [ -f "$path" ]; then
            mtime="$(stat -c '%y' "$path" 2>/dev/null | cut -d. -f1)"
            ok "archive: ~/$a -> ${path##*/} (${mtime:-?})"
        else
            warn "archive: no ${path##*/} yet (run: devenv snapshot)"
        fi
    done

    step "snapshot files"
    local rel snap_path
    for rel in "${SNAPSHOT_FILES[@]}"; do
        snap_path="$(_snapshot_file_path "$rel")"
        if [ -f "$snap_path" ]; then
            mtime="$(stat -c '%y' "$snap_path" 2>/dev/null | cut -d. -f1)"
            ok "snapshot-file: ~/$rel (${mtime:-?})"
        elif [ -f "$DEVENV_HOME/$rel" ]; then
            log "snapshot-file: ~/$rel will seed from template on next restore"
        else
            warn "snapshot-file: no snapshot or template for ~/$rel"
        fi
    done

    step "claude.json auth subset"
    snap_path="$(_claude_json_auth_path)"
    if [ -f "$snap_path" ]; then
        mtime="$(stat -c '%y' "$snap_path" 2>/dev/null | cut -d. -f1)"
        ok "claude-json-auth: ${snap_path##*/} (${mtime:-?}) keys=${CLAUDE_JSON_AUTH_KEYS[*]}"
    else
        warn "claude-json-auth: not snapshotted yet (run \`devenv snapshot\` while logged in)"
    fi

    echo
    if [ $fails -eq 0 ]; then ok "doctor: all clear"; else warn "doctor: $fails issue(s)"; return 1; fi
}

cmd_sync() {
    if [ -d "$DEVENV_ROOT/.git" ]; then
        ( cd "$DEVENV_ROOT" && git status --short )
        log "tip: cd $DEVENV_ROOT && git add -A && git commit -m 'sync'"
    else
        log "home/ is symlinked live — no sync needed. (init a git repo at $DEVENV_ROOT to track history.)"
    fi
}

# ---------------------------------------------------------------------------
# snapshot / restore
# ---------------------------------------------------------------------------

# rsync is mandatory. The cp -a fallback that used to live here was unreliable
# on virtio-fs (Android shared storage) and could crash the VM mid-copy. The
# bootstrap installs rsync before any snapshot/restore runs.
_ensure_rsync() {
    have rsync || die "rsync is required for snapshot/restore — install with: sudo apt install rsync"
}

# rsync flags shared by every snapshot copy. The destination is the FUSE/
# sdcardfs shared mount, which can't store POSIX metadata:
#   --no-links                it can't create symlinks (virtio-fs)
#   --no-perms/-owner/-group  it forces its own mode+ownership, so asking rsync
#   --no-times                to preserve metadata only yields "failed to set
#                             permissions" errors and a code-23 exit. Mode-
#                             sensitive dirs (~/.ssh) go through tar (ARCHIVE_DIRS)
#                             instead. Each snapshot is a full copy into a fresh
#                             *.partial, so dropped mtimes cost nothing (there is
#                             no incremental reuse to preserve).
DEVENV_SNAPSHOT_RSYNC=(-a --no-links --no-perms --no-owner --no-group --no-times --info=progress2)

# Run an rsync into the snapshot tree, tolerating the partial-transfer exits
# (23/24). On this mount a single file whose name it can't represent (e.g. a
# stray `config.yaml:` — colon is forbidden) makes rsync exit 23; under
# `set -euo pipefail` that aborted the whole snapshot, leaving an unpromoted
# *.partial. That failure was silent and cost 20 days of dead snapshots behind
# one junk file. Now: warn, skip that file, keep the rest of the snapshot.
_snapshot_rsync() {
    local rc=0
    rsync "$@" || rc=$?
    case "$rc" in
        0) ;;
        23|24) warn "snapshot: rsync partial transfer (exit $rc) — a file the shared mount can't store was skipped; rest captured" ;;
        *)     die "snapshot: rsync failed (exit $rc)" ;;
    esac
}

# Copy a single entry from $HOME into the snapshot tree.
_snapshot_entry() {
    local name="$1"
    local src="$HOME/$name"
    local dst="$DEVENV_SNAPSHOT_DIR/home/$name"

    if [ -L "$src" ]; then
        warn "snapshot: ~/$name is a symlink; skipping (run \`devenv init\` to detach legacy symlinks)"
        return 0
    fi
    if [ ! -e "$src" ]; then
        warn "snapshot: ~/$name does not exist; skipping"
        return 0
    fi

    if [ -d "$src" ]; then
        mkdir -p "$dst"
        # virtio-fs on Android shared storage can't create symlinks, so we skip
        # them outright with --no-links. *.wants/ (systemd enable-state symlink
        # dirs) is excluded as a whole because it would be empty after
        # --no-links anyway; systemctl --user enable in init.sh recreates it
        # on restore.
        _snapshot_rsync "${DEVENV_SNAPSHOT_RSYNC[@]}" --delete \
            --exclude='*.db-wal' --exclude='*.db-shm' --exclude='*.lock' \
            --exclude='*.wants/' \
            --exclude='systemd/user/devenv-snapshot.service' \
            --exclude='systemd/user/devenv-watch.service' \
            --exclude='pulse/' \
            --exclude='btop/btop.log' \
            "$src/" "$dst/"
        ok "snapshot: ~/$name/"
    else
        # Regular file (e.g. .bash_history).
        mkdir -p "$(dirname "$dst")"
        _snapshot_rsync "${DEVENV_SNAPSHOT_RSYNC[@]}" -- "$src" "$dst"
        ok "snapshot: ~/$name"
    fi
}

_archive_path() {
    # archives/<name-without-leading-dot>.tar.gz so the directory listing reads
    # ssh.tar.gz / gnupg.tar.gz instead of .ssh.tar.gz / .gnupg.tar.gz.
    printf '%s/%s.tar.gz\n' "$DEVENV_ARCHIVES" "${1#.}"
}

# Snapshot/restore location for SNAPSHOT_FILES entries — mirrors the file's
# HOME-relative path under $DEVENV_SNAPSHOT_DIR/files/. Kept separate from
# state/home/ (used by STATEFUL_DIRS) so the two mechanisms can't collide.
_snapshot_file_path() {
    printf '%s/files/%s\n' "$DEVENV_SNAPSHOT_DIR" "$1"
}

# Where the extracted auth subset of ~/.claude.json is parked.
_claude_json_auth_path() {
    printf '%s/files/.claude/claude-json-auth.json\n' "$DEVENV_SNAPSHOT_DIR"
}

# Snapshot the auth keys from ~/.claude.json into a small JSON file. We do not
# snapshot the whole file (history of corruption on the shared mount); only
# the keys in CLAUDE_JSON_AUTH_KEYS get carried across rebuilds.
_snapshot_claude_json() {
    local src="$HOME/.claude.json"
    local dst; dst="$(_claude_json_auth_path)"

    if [ ! -f "$src" ]; then
        log "snapshot-claude-json: ~/.claude.json missing; skipping"
        return 0
    fi
    if ! have jq; then
        warn "snapshot-claude-json: jq missing; cannot extract auth subset"
        return 0
    fi

    mkdir -p "$(dirname "$dst")"
    # Build a jq object literal from CLAUDE_JSON_AUTH_KEYS: {oauthAccount, userID, ...}
    local filter; filter="$(printf '%s, ' "${CLAUDE_JSON_AUTH_KEYS[@]}" | sed 's/, $//')"
    local tmp="$dst.tmp.$$"
    if jq "{$filter}" "$src" > "$tmp"; then
        mv -- "$tmp" "$dst"
        chmod 600 "$dst" 2>/dev/null || true
        ok "snapshot-claude-json: ~/.claude.json (keys: ${CLAUDE_JSON_AUTH_KEYS[*]})"
    else
        rm -f -- "$tmp"
        warn "snapshot-claude-json: jq failed; auth subset not updated"
    fi
}

# Restore the auth subset by merging into the live ~/.claude.json (or seeding
# a fresh one if it doesn't exist yet). Snapshot keys win on conflict, so the
# restored oauthAccount/userID match the restored .credentials.json.
_restore_claude_json() {
    local snap; snap="$(_claude_json_auth_path)"
    local live="$HOME/.claude.json"

    [ -f "$snap" ] || return 1
    if ! have jq; then
        warn "restore-claude-json: jq missing; cannot merge auth subset"
        return 1
    fi

    mkdir -p "$(dirname "$live")"
    local tmp="$live.devenv-restore.$$"
    if [ -f "$live" ]; then
        # live * snap → snap's keys override live's. Write temp, atomic rename.
        if ! jq -s '.[0] * .[1]' "$live" "$snap" > "$tmp"; then
            rm -f -- "$tmp"
            warn "restore-claude-json: jq merge failed; ~/.claude.json untouched"
            return 1
        fi
    else
        # Fresh — just stage the snapshot subset as the seed file.
        cp -- "$snap" "$tmp"
    fi
    mv -- "$tmp" "$live"
    chmod 600 "$live" 2>/dev/null || true
    ok "restored ~/.claude.json (merged auth subset)"
    return 0
}

# Copy a single file from $HOME into the snapshot tree. Uses rsync (cp can
# crash mid-write on the /mnt/shared FUSE/sdcardfs bridge).
_snapshot_file() {
    local rel="$1"
    local src="$HOME/$rel"
    local dst; dst="$(_snapshot_file_path "$rel")"

    if [ -L "$src" ]; then
        warn "snapshot-file: ~/$rel is a symlink; skipping"
        return 0
    fi
    if [ ! -f "$src" ]; then
        log "snapshot-file: ~/$rel does not exist; skipping"
        return 0
    fi

    mkdir -p "$(dirname "$dst")"
    _snapshot_rsync "${DEVENV_SNAPSHOT_RSYNC[@]}" -- "$src" "$dst"
    ok "snapshot-file: ~/$rel"
}

# Restore a single file into $HOME. Falls back to $DEVENV_HOME/<rel> as a
# template when no snapshot copy exists yet (first-run seeding of CLAUDE.md).
# Returns 0 if anything was restored, 1 if no source was found.
_restore_file() {
    local rel="$1"
    local dst="$HOME/$rel"
    local snap; snap="$(_snapshot_file_path "$rel")"
    local tmpl="$DEVENV_HOME/$rel"
    local src=""

    if [ -f "$snap" ]; then
        src="$snap"
    elif [ -f "$tmpl" ]; then
        src="$tmpl"
        log "restore-file: no snapshot for ~/$rel, seeding from template $tmpl"
    else
        return 1
    fi

    mkdir -p "$(dirname "$dst")"
    if [ -L "$dst" ]; then
        warn "restore-file: ~/$rel was a symlink ($(readlink "$dst")); removing before restore"
        rm -- "$dst"
    fi
    rsync -a --info=progress2 -- "$src" "$dst"

    # Tighten perms on known-sensitive files. rsync from /mnt/shared loses
    # mode bits anyway, so we set them explicitly per file.
    case "$rel" in
        .claude/.credentials.json) chmod 600 "$dst" 2>/dev/null || true ;;
    esac

    ok "restored ~/$rel"
    return 0
}

# Snapshot ~/<name> into a tar.gz at archives/<name>.tar.gz. Perms are
# preserved in the tar metadata regardless of what the destination filesystem
# (FUSE/sdcardfs) does to mode bits on the bare files.
_snapshot_archive() {
    local name="$1"
    local src="$HOME/$name"
    local out; out="$(_archive_path "$name")"

    if [ -L "$src" ]; then
        warn "archive: ~/$name is a symlink; skipping"
        return 0
    fi
    if [ ! -e "$src" ]; then
        log "archive: ~/$name does not exist; skipping"
        return 0
    fi

    mkdir -p "$(dirname "$out")"
    local tmp="${out}.tmp.$$"
    # Run from $HOME so the archive contains ".ssh/..." not "/home/user/.ssh/...".
    if ( cd "$HOME" && tar -czf "$tmp" -- "$name" ); then
        mv -- "$tmp" "$out"
        ok "archive: ~/$name -> $out ($(stat -c %s "$out" 2>/dev/null || echo ?) bytes)"
    else
        rm -f -- "$tmp"
        err "archive: failed to write $out"
        return 1
    fi
}

# Enforce strict perms after extraction. tar metadata should already carry the
# right modes, but a belt-and-suspenders chmod here means a tarball edited by
# something perm-blind on the shared mount can't silently break SSH.
_archive_perms_fix() {
    local name="$1"
    local dst="$HOME/$name"
    [ -d "$dst" ] || return 0
    case "$name" in
        .ssh)
            chmod 700 "$dst" || true
            local f
            while IFS= read -r f; do
                case "$(basename "$f")" in
                    *.pub) chmod 644 "$f" || true ;;
                    *)     chmod 600 "$f" || true ;;
                esac
            done < <(find "$dst" -maxdepth 1 -type f)
            ;;
        .gnupg)
            chmod 700 "$dst" || true
            find "$dst" -type d -exec chmod 700 {} + 2>/dev/null || true
            find "$dst" -type f -exec chmod 600 {} + 2>/dev/null || true
            ;;
    esac
}

_restore_archive() {
    local name="$1"
    local in; in="$(_archive_path "$name")"

    if [ ! -f "$in" ]; then
        return 1
    fi

    # Drop a leftover legacy symlink (~/.ssh -> /mnt/shared/...) before extract.
    if [ -L "$HOME/$name" ]; then
        warn "restore: ~/$name was a symlink ($(readlink "$HOME/$name")); removing before extract"
        rm -- "$HOME/$name"
    fi

    # tar -x overwrites files in the archive without deleting extras already on
    # disk — same merge semantics as the rsync-based STATEFUL_DIRS restore.
    if ( cd "$HOME" && tar -xzf "$in" ); then
        ok "restored ~/$name from $in"
        _archive_perms_fix "$name"
        return 0
    else
        err "restore: extract failed for $in"
        return 1
    fi
}

cmd_snapshot() {
    _ensure_rsync
    mkdir -p "$DEVENV_SNAPSHOTS_DIR"
    _migrate_legacy_snapshot

    local ts; ts="${DEVENV_SNAPSHOT_TS:-$(date -u +%Y%m%d-%H%M%S)}"
    local final="$DEVENV_SNAPSHOTS_DIR/$ts"
    local partial="$final.partial"
    if [ -e "$final" ]; then
        warn "snapshot: version $ts already exists; skipping (try again in 1s)"
        return 0
    fi
    rm -rf -- "$partial"
    mkdir -p "$partial/home"

    # Point the existing snapshot helpers at this version dir. DEVENV_STATE
    # (sentinels) is defined independently in lib.sh and is NOT affected.
    DEVENV_SNAPSHOT_DIR="$partial"
    DEVENV_ARCHIVES="$partial"

    step "snapshot -> $partial"

    local name
    for name in "${STATEFUL_DIRS[@]}"; do
        _snapshot_entry "$name"
    done

    for name in "${ARCHIVE_DIRS[@]}"; do
        _snapshot_archive "$name"
    done

    local rel
    for rel in "${SNAPSHOT_FILES[@]}"; do
        _snapshot_file "$rel"
    done

    _snapshot_claude_json

    if have dpkg; then
        dpkg --get-selections >"$partial/dpkg-selections.txt"
        ok "wrote dpkg-selections.txt ($(wc -l <"$partial/dpkg-selections.txt") lines)"
    else
        warn "dpkg not available; skipping dpkg-selections.txt"
    fi
    if have apt-mark; then
        apt-mark showmanual >"$partial/apt-manual.txt"
        ok "wrote apt-manual.txt ($(wc -l <"$partial/apt-manual.txt") lines)"
    else
        warn "apt-mark not available; skipping apt-manual.txt"
    fi

    # meta LAST = completion marker, then promote partial -> final.
    _write_meta "$partial"
    mv -- "$partial" "$final"
    _prune_versions
    ok "snapshot complete: version $ts ($(_version_count) retained)"
}

# Copy a single entry from the snapshot tree back into $HOME.
# No --delete: never wipe VM-side files that happen to be newer.
_restore_entry() {
    local name="$1"
    local src="$DEVENV_SNAPSHOT_DIR/home/$name"
    local dst="$HOME/$name"

    if [ ! -e "$src" ]; then
        return 1
    fi

    # If the destination is a leftover legacy symlink, drop it so we write a
    # real file/dir at $HOME — not into /mnt/shared.
    if [ -L "$dst" ]; then
        warn "restore: ~/$name was a symlink ($(readlink "$dst")); removing before restore"
        rm -- "$dst"
    fi

    if [ -d "$src" ]; then
        mkdir -p "$dst"
        rsync -a --info=progress2 -- "$src/" "$dst/"
        ok "restored ~/$name/"
    else
        mkdir -p "$(dirname "$dst")"
        rsync -a --info=progress2 -- "$src" "$dst"
        ok "restored ~/$name"
    fi
    return 0
}

cmd_restore() {
    local rollback=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --rollback)    rollback=1 ;;
            --rollback=*)  rollback="${1#*=}" ;;
            *)             warn "restore: ignoring unknown arg: $1" ;;
        esac
        shift
    done

    _ensure_rsync

    # Resolve which version to read. Versioned store wins; fall back to the
    # legacy single-copy state/ + archives/ when no versions exist yet.
    if [ -n "$(_list_versions)" ]; then
        local src
        if ! src="$(_version_at "$rollback")"; then
            die "restore: --rollback=$rollback out of range — only $(_version_count) version(s) available (see: devenv snapshots)"
        fi
        DEVENV_SNAPSHOT_DIR="$src"
        DEVENV_ARCHIVES="$src"
        log "restoring from version: $(basename "$src")$([ "$rollback" != 0 ] && printf ' (rolled back %s)' "$rollback")"
    else
        [ "$rollback" = 0 ] || die "restore: no versioned snapshots yet; --rollback unavailable"
        log "no versioned snapshots; restoring from legacy state/ + archives/"
    fi

    step "restore <- $DEVENV_SNAPSHOT_DIR (+ archives)"

    if [ -f "$DEVENV_SNAPSHOT_DIR/snapshot.ts" ]; then
        log "snapshot taken: $(cat "$DEVENV_SNAPSHOT_DIR/snapshot.ts")"
    else
        warn "no snapshot.ts found — restoring whatever is present"
    fi

    local restored=() skipped=()
    local name

    # STATEFUL_DIRS — rsync from $DEVENV_SNAPSHOT_DIR/home/<name>.
    if [ -d "$DEVENV_SNAPSHOT_DIR/home" ]; then
        for name in "${STATEFUL_DIRS[@]}"; do
            if _restore_entry "$name"; then
                restored+=("$name")
            else
                skipped+=("$name")
            fi
        done
    else
        for name in "${STATEFUL_DIRS[@]}"; do skipped+=("$name"); done
    fi

    # ARCHIVE_DIRS — extract from $DEVENV_ARCHIVES/<name>.tar.gz.
    for name in "${ARCHIVE_DIRS[@]}"; do
        if _restore_archive "$name"; then
            restored+=("$name")
        else
            skipped+=("$name")
        fi
    done

    # SNAPSHOT_FILES — single files from $DEVENV_SNAPSHOT_DIR/files/<rel>,
    # falling back to $DEVENV_HOME/<rel> template if no snapshot yet.
    local rel
    for rel in "${SNAPSHOT_FILES[@]}"; do
        if _restore_file "$rel"; then
            restored+=("$rel")
        else
            skipped+=("$rel")
        fi
    done

    # JSON-merge files (currently just ~/.claude.json auth subset).
    if _restore_claude_json; then
        restored+=(".claude.json[auth]")
    else
        skipped+=(".claude.json[auth]")
    fi

    if [ ${#restored[@]} -gt 0 ]; then
        ok "restored: ${restored[*]}"
    else
        log "no entries restored"
    fi
    if [ ${#skipped[@]} -gt 0 ]; then
        log "no snapshot/archive data for: ${skipped[*]}"
    fi
}
cmd_snapshots() {
    if [ -z "$(_list_versions)" ]; then
        warn "no versioned snapshots yet (run: devenv snapshot)"
        return 0
    fi
    printf '%-3s  %-17s  %-7s  %-25s  %s\n' "#" VERSION SIZE CREATED ""
    local i=0 line ts size created marker
    while IFS= read -r line; do
        ts="$(basename "$line")"
        size="$(du -sh "$line" 2>/dev/null | cut -f1)"
        created="$(grep -o '"created"[^,]*' "$line/meta" 2>/dev/null | cut -d'"' -f4)"
        if [ "$i" = 0 ]; then marker="<- current (devenv restore)"; else marker="devenv restore --rollback=$i"; fi
        printf '%-3s  %-17s  %-7s  %-25s  %s\n' "$i" "$ts" "${size:-?}" "${created:-?}" "$marker"
        i=$((i+1))
    done < <(_list_versions)
}

# ---------------------------------------------------------------------------
# probe — measure the signals that actually predict VM degradation
# ---------------------------------------------------------------------------
# Philosophy: don't harden on gut feeling. Sample the kernel's own stall and
# pressure signals, append them to a cross-rebuild log, and let the TREND tell
# us which lever (if any) is worth pulling. See docs/harden-spec.md for the
# symptom -> signal -> lever framework this feeds.
#
# Signals collected (all read-only, no sudo needed on this kernel):
#   - PSI  /proc/pressure/{cpu,memory,io}  total= microseconds  (THE stall
#          signal: "full" memory/io means tasks were literally stalled waiting)
#   - mem  /proc/meminfo MemAvailable low-water + SwapUsed (zram) high-water
#   - zram /sys/block/zram0/mm_stat mem_used_total high-water (near-full zram =
#          the next allocation OOMs)
#   - oom  dmesg matches for oom-kill / Killed process / hung_task / blocked-for
#   - io   timed ls of the shared mount root (its latency IS the degradation
#          everyone feels first)
#   - peak RSS of the claude process tree (the agent is the VM's single point of
#          failure; if it gets OOM-killed the session dies)

# Read one numeric field (kB) from /proc/meminfo.
_meminfo_kb() { awk -v k="$1:" '$1==k{print $2; exit}' /proc/meminfo 2>/dev/null || echo 0; }

# PSI total microseconds for <resource> <some|full>. 0 if unavailable.
_psi_total() {
    awk -v want="$2" '$1==want{for(i=2;i<=NF;i++) if($i ~ /^total=/){sub(/total=/,"",$i); print $i; exit}}' \
        "/proc/pressure/$1" 2>/dev/null || echo 0
}

# zram mem_used_total (bytes) — 3rd field of mm_stat.
_zram_memused() { awk '{print $3; exit}' /sys/block/zram0/mm_stat 2>/dev/null || echo 0; }

# Sum RSS (kB) of every process whose command line matches a regex.
_match_rss() { ps -eo rss=,args= 2>/dev/null | awk -v p="$1" '$0 ~ p && $0 !~ /devenv probe/ {s+=$1} END{print s+0}'; }

# Count cumulative kernel degradation events in the ring buffer.
_oom_count() { dmesg 2>/dev/null | grep -ciE 'out of memory|killed process|oom-kill|hung_task|blocked for more than [0-9]+ sec' || true; }

# Round-trip latency (ms) of a trivial op on the shared mount.
_shared_latency_ms() {
    local t0 t1; t0=$(date +%s%N); ls "$DEVENV_ROOT" >/dev/null 2>&1; t1=$(date +%s%N)
    echo $(( (t1 - t0) / 1000000 ))
}

cmd_probe() {
    local watch=0 label="snapshot" interval=2
    local -a runcmd=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --watch)    watch="${2:?--watch needs SECONDS}"; shift 2 ;;
            --watch=*)  watch="${1#*=}"; shift ;;
            --label)    label="${2:?--label needs a value}"; shift 2 ;;
            --label=*)  label="${1#*=}"; shift ;;
            --tail)     shift; tail -n "${1:-20}" "$DEVENV_METRICS/probe.jsonl" 2>/dev/null || warn "no probe log yet"; return 0 ;;
            --)         shift; runcmd=("$@"); break ;;
            *)          die "probe: unknown arg: $1 (see: devenv help)" ;;
        esac
    done
    mkdir -p "$DEVENV_METRICS"
    local log="$DEVENV_METRICS/probe.jsonl"

    local mode="snapshot"
    [ "$watch" -gt 0 ] && mode="watch"
    [ ${#runcmd[@]} -gt 0 ] && mode="run"

    # Baselines (start of measurement window).
    local mem_total; mem_total="$(_meminfo_kb MemTotal)"
    local swap_total; swap_total="$(_meminfo_kb SwapTotal)"
    local psi_cpu0 psi_mem0 psi_memf0 psi_io0 psi_iof0
    psi_cpu0="$(_psi_total cpu some)";  psi_mem0="$(_psi_total memory some)"
    psi_memf0="$(_psi_total memory full)"; psi_io0="$(_psi_total io some)"; psi_iof0="$(_psi_total io full)"
    local oom0; oom0="$(_oom_count)"
    local t_start; t_start=$(date +%s)

    # Running aggregates.
    local mem_avail_min=999999999 swap_used_max=0 zram_max=0 rss_max=0

    # Take one sample, updating the aggregates above.
    _probe_take_sample() {
        local ma su zr rss
        ma="$(_meminfo_kb MemAvailable)"
        su=$(( swap_total - $(_meminfo_kb SwapFree) ))
        zr="$(_zram_memused)"
        rss="$(_match_rss '(^|[ /])claude([ ]|$)|node .*claude|\.claude')"
        [ "$ma" -lt "$mem_avail_min" ] && mem_avail_min="$ma"
        [ "$su" -gt "$swap_used_max" ] && swap_used_max="$su"
        [ "$zr" -gt "$zram_max" ] && zram_max="$zr"
        [ "$rss" -gt "$rss_max" ] && rss_max="$rss"
        return 0   # never let a false [ -gt ] above become the func's exit (set -e)
    }

    local cmd_exit=""
    case "$mode" in
        snapshot)
            _probe_take_sample
            ;;
        watch)
            log "probe: sampling ${watch}s (every ${interval}s)…"
            local elapsed=0
            while [ "$elapsed" -lt "$watch" ]; do
                _probe_take_sample
                sleep "$interval"; elapsed=$(( elapsed + interval ))
            done
            _probe_take_sample
            ;;
        run)
            log "probe: running [${runcmd[*]}] and measuring until it exits…"
            "${runcmd[@]}" &
            local pid=$!
            while kill -0 "$pid" 2>/dev/null; do
                _probe_take_sample
                sleep 1
                if [ "$watch" -gt 0 ] && [ $(( $(date +%s) - t_start )) -ge "$watch" ]; then break; fi
            done
            if wait "$pid" 2>/dev/null; then cmd_exit=0; else cmd_exit=$?; fi
            _probe_take_sample
            ;;
    esac

    local t_end; t_end=$(date +%s)
    local dur=$(( t_end - t_start ))
    local mem_avail_now; mem_avail_now="$(_meminfo_kb MemAvailable)"
    local load1; load1="$(awk '{print $1; exit}' /proc/loadavg 2>/dev/null || echo 0)"
    local lat; lat="$(_shared_latency_ms)"
    local oom1; oom1="$(_oom_count)"
    local uptime_s; uptime_s="$(awk '{print int($1); exit}' /proc/uptime 2>/dev/null || echo 0)"
    local kern; kern="$(uname -r)"
    local host; host="$(uname -n)"
    local ts; ts="$(date -Iseconds)"

    # PSI deltas over the window (microseconds of stall accrued during measure).
    local d_cpu=$(( $(_psi_total cpu some) - psi_cpu0 ))
    local d_mem=$(( $(_psi_total memory some) - psi_mem0 ))
    local d_memf=$(( $(_psi_total memory full) - psi_memf0 ))
    local d_io=$(( $(_psi_total io some) - psi_io0 ))
    local d_iof=$(( $(_psi_total io full) - psi_iof0 ))
    local d_oom=$(( oom1 - oom0 ))

    # Emit one JSON line. Prefer jq for correctness; fall back to printf.
    local line
    if have jq; then
        line="$(jq -nc \
            --arg ts "$ts" --arg host "$host" --arg kern "$kern" --arg mode "$mode" --arg label "$label" \
            --argjson uptime "$uptime_s" --argjson dur "$dur" \
            --argjson mem_total "$mem_total" --argjson mem_avail_min "$mem_avail_min" --argjson mem_avail_now "$mem_avail_now" \
            --argjson swap_total "$swap_total" --argjson swap_used_max "$swap_used_max" --argjson zram_max "$zram_max" \
            --argjson rss_max "$rss_max" --argjson load1 "$load1" --argjson lat_ms "$lat" \
            --argjson psi_cpu_some "$d_cpu" --argjson psi_mem_some "$d_mem" --argjson psi_mem_full "$d_memf" \
            --argjson psi_io_some "$d_io" --argjson psi_io_full "$d_iof" --argjson oom_delta "$d_oom" \
            --arg cmd_exit "$cmd_exit" \
            '{ts:$ts,host:$host,kernel:$kern,mode:$mode,label:$label,uptime_s:$uptime,dur_s:$dur,
              mem_total_kb:$mem_total,mem_avail_min_kb:$mem_avail_min,mem_avail_now_kb:$mem_avail_now,
              swap_total_kb:$swap_total,swap_used_max_kb:$swap_used_max,zram_memused_max_b:$zram_max,
              claude_rss_max_kb:$rss_max,load1:$load1,shared_latency_ms:$lat_ms,
              psi_us:{cpu_some:$psi_cpu_some,mem_some:$psi_mem_some,mem_full:$psi_mem_full,io_some:$psi_io_some,io_full:$psi_io_full},
              oom_events_delta:$oom_delta,cmd_exit:($cmd_exit|if .=="" then null else tonumber end)}')"
    else
        line="{\"ts\":\"$ts\",\"mode\":\"$mode\",\"label\":\"$label\",\"mem_avail_min_kb\":$mem_avail_min,\"swap_used_max_kb\":$swap_used_max,\"zram_memused_max_b\":$zram_max,\"claude_rss_max_kb\":$rss_max,\"psi_us\":{\"mem_full\":$d_memf,\"io_full\":$d_iof,\"cpu_some\":$d_cpu},\"oom_events_delta\":$d_oom,\"shared_latency_ms\":$lat}"
    fi
    printf '%s\n' "$line" >> "$log"

    # Human summary — lead with the degradation-relevant numbers.
    step "probe ($mode${label:+, $label})"
    printf '  mem: %s MB free now, low-water %s MB of %s MB total\n' \
        "$(( mem_avail_now / 1024 ))" "$(( mem_avail_min / 1024 ))" "$(( mem_total / 1024 ))"
    printf '  zram swap: peak used %s MB of %s MB; mem_used_total peak %s MB\n' \
        "$(( swap_used_max / 1024 ))" "$(( swap_total / 1024 ))" "$(( zram_max / 1048576 ))"
    printf '  claude tree peak RSS: %s MB\n' "$(( rss_max / 1024 ))"
    printf '  PSI stall this window (µs): cpu.some=%s  mem.full=%s  io.full=%s\n' "$d_cpu" "$d_memf" "$d_iof"
    printf '  shared-mount latency: %s ms   OOM/hung events: %s (Δ %s)\n' "$lat" "$oom1" "$d_oom"
    [ -n "$cmd_exit" ] && printf '  command exit: %s\n' "$cmd_exit"
    if [ "$d_memf" -gt 0 ] || [ "$d_oom" -gt 0 ]; then
        warn "memory stall or OOM observed — this is the signal earlyoom/oom_score_adj would address (see harden-spec)"
    elif [ "$d_iof" -gt 0 ]; then
        log "only IO stall observed — degradation here is the shared mount, not memory (tmpfs/ccache territory, not earlyoom)"
    fi
    ok "probe appended -> ${log/#$HOME/\~}  ($(wc -l <"$log" 2>/dev/null || echo 0) samples)"
}

# ---------------------------------------------------------------------------
# watch — adaptive degradation watcher (the load-time companion to `probe`)
# ---------------------------------------------------------------------------
# Bootstrap baselines (probe) only catch a fresh, idle VM — which always looks
# fine. Real degradation shows up under heavy work (node/python scripts, multi-
# agent runs). This watcher catches THAT without everyday overhead or log bloat:
#
#   calm:  every CALM seconds read just the 3 PSI files + MemAvailable (cheap,
#          NO ps/dmesg, NO log write). An idle VM logs nothing for hours.
#   trip:  when mem.full / io.full stall %, low MemAvailable, or a new OOM/hung
#          event crosses a threshold -> switch to FAST sampling, capture the
#          culprit process tree (who's eating RSS/CPU: node? python? N claudes?)
#   close: when calm returns for QUIET consecutive fast-ticks, write ONE
#          coalesced episode record to metrics/episodes.jsonl and resume calm.
#
# So the log grows in proportion to how often the VM actually struggles, and
# each row tells you the WHY, not just the WHEN. See docs/harden-spec.md.
# Tunables (env): DEVENV_WATCH_{CALM,FAST,QUIET,MEM_FULL_PCT,IO_FULL_PCT,MEM_FLOOR_MB,MAX_EPISODES}

# Top 5 processes by RSS as a JSON array — the "who caused it" for an episode.
_top_procs_json() {
    ps -eo rss=,pcpu=,comm=,args= --sort=-rss 2>/dev/null | head -n 5 | \
    jq -R -s 'split("\n") | map(select(length>0)) | map(
        capture("^ *(?<rss>[0-9]+) +(?<cpu>[0-9.]+) +(?<comm>[^ ]+) +(?<args>.*)$") // empty
        | {comm:.comm, rss_kb:(.rss|tonumber), pcpu:(.cpu|tonumber), args:(.args[0:80])}
    )' 2>/dev/null || echo '[]'
}

cmd_watch() {
    # Long-running daemon loop: disable errexit so a transient read failure or a
    # false `[ ] && x` test can never kill the watcher (systemd also restarts it).
    set +e
    local CALM=${DEVENV_WATCH_CALM:-15} FAST=${DEVENV_WATCH_FAST:-3} QUIET=${DEVENV_WATCH_QUIET:-3}
    local MEM_PCT=${DEVENV_WATCH_MEM_FULL_PCT:-1.0} IO_PCT=${DEVENV_WATCH_IO_FULL_PCT:-10.0}
    local MEM_FLOOR=${DEVENV_WATCH_MEM_FLOOR_MB:-300} MAXEP=${DEVENV_WATCH_MAX_EPISODES:-1000}
    local once=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --once)  once=1 ;;
            --tail)  shift; tail -n "${1:-20}" "$DEVENV_METRICS/episodes.jsonl" 2>/dev/null || warn "no episodes logged yet"; return 0 ;;
            *)       die "watch: unknown arg: $1 (see: devenv help)" ;;
        esac
        shift
    done
    have jq || die "watch: jq required (install-base provides it)"
    mkdir -p "$DEVENV_METRICS"
    local elog="$DEVENV_METRICS/episodes.jsonl"
    local nproc_n; nproc_n=$(nproc 2>/dev/null || echo 8)

    log "watch: calm=${CALM}s fast=${FAST}s triggers[mem.full>${MEM_PCT}% io.full>${IO_PCT}% memavail<${MEM_FLOOR}MB oom>0] -> ${elog/#$HOME/\~}"

    local p_memf p_iof oom_prev t_prev
    p_memf=$(_psi_total memory full); p_iof=$(_psi_total io full)
    oom_prev=$(_oom_count); t_prev=$(date +%s)

    while :; do
        sleep "$CALM"
        local t_now elapsed; t_now=$(date +%s); elapsed=$(( t_now - t_prev )); [ "$elapsed" -lt 1 ] && elapsed=1
        local c_memf c_iof ma oom_now
        c_memf=$(_psi_total memory full); c_iof=$(_psi_total io full)
        ma=$(( $(_meminfo_kb MemAvailable) / 1024 )); oom_now=$(_oom_count)
        local mem_pct io_pct
        mem_pct=$(awk -v d="$(( c_memf - p_memf ))" -v e="$elapsed" 'BEGIN{printf "%.3f",(d/(e*1000000))*100}')
        io_pct=$(awk  -v d="$(( c_iof  - p_iof  ))" -v e="$elapsed" 'BEGIN{printf "%.3f",(d/(e*1000000))*100}')

        local reason=""
        if   awk -v a="$mem_pct" -v b="$MEM_PCT" 'BEGIN{exit !(a+0>b+0)}'; then reason="mem.full=${mem_pct}%"
        elif awk -v a="$io_pct"  -v b="$IO_PCT"  'BEGIN{exit !(a+0>b+0)}'; then reason="io.full=${io_pct}%"
        elif [ "$ma" -lt "$MEM_FLOOR" ]; then reason="mem_avail=${ma}MB"
        elif [ "$oom_now" -gt "$oom_prev" ]; then reason="oom/hung+$(( oom_now - oom_prev ))"
        fi

        if [ -n "$reason" ]; then
            # ---- episode: fast-sample until calm for QUIET consecutive ticks ----
            local start_ts te0 em0 ei0 ec0 oom_e0
            start_ts=$(date -Iseconds); te0=$(date +%s)
            em0=$c_memf; ei0=$c_iof; ec0=$(_psi_total cpu some); oom_e0=$oom_prev
            local ma_min=$ma swap_max zram_max top_json quiet=0 lm=$c_memf li=$c_iof lt
            swap_max=$(( $(_meminfo_kb SwapTotal) - $(_meminfo_kb SwapFree) ))
            zram_max=$(_zram_memused); top_json=$(_top_procs_json); lt=$(date +%s)
            warn "episode START ($reason)"
            while [ "$quiet" -lt "$QUIET" ]; do
                sleep "$FAST"
                local ft fe nm ni nma su zr mp ip still
                ft=$(date +%s); fe=$(( ft - lt )); [ "$fe" -lt 1 ] && fe=1
                nm=$(_psi_total memory full); ni=$(_psi_total io full)
                nma=$(( $(_meminfo_kb MemAvailable) / 1024 ))
                [ "$nma" -lt "$ma_min" ] && ma_min=$nma
                su=$(( $(_meminfo_kb SwapTotal) - $(_meminfo_kb SwapFree) )); zr=$(_zram_memused)
                [ "$su" -gt "$swap_max" ] && swap_max=$su
                [ "$zr" -gt "$zram_max" ] && zram_max=$zr
                top_json=$(_top_procs_json)   # refresh culprit list while hot
                mp=$(awk -v d="$(( nm - lm ))" -v e="$fe" 'BEGIN{printf "%.3f",(d/(e*1000000))*100}')
                ip=$(awk -v d="$(( ni - li ))" -v e="$fe" 'BEGIN{printf "%.3f",(d/(e*1000000))*100}')
                still=0
                if   awk -v a="$mp" -v b="$MEM_PCT" 'BEGIN{exit !(a+0>b+0)}'; then still=1
                elif awk -v a="$ip" -v b="$IO_PCT"  'BEGIN{exit !(a+0>b+0)}'; then still=1
                elif [ "$nma" -lt "$MEM_FLOOR" ]; then still=1
                fi
                if [ "$still" = 1 ]; then quiet=0; else quiet=$(( quiet + 1 )); fi
                lm=$nm; li=$ni; lt=$ft
            done
            local end_ts dur fm fio fc oomd
            end_ts=$(date -Iseconds); dur=$(( $(date +%s) - te0 ))
            fm=$(( $(_psi_total memory full) - em0 )); fio=$(( $(_psi_total io full) - ei0 ))
            fc=$(( $(_psi_total cpu some) - ec0 )); oomd=$(( $(_oom_count) - oom_e0 ))
            local rec
            rec=$(jq -nc \
                --arg start "$start_ts" --arg end "$end_ts" --arg reason "$reason" --arg host "$(uname -n)" \
                --argjson dur "$dur" --argjson mem_full "$fm" --argjson io_full "$fio" --argjson cpu_some "$fc" \
                --argjson ma_min "$ma_min" --argjson swap_max "$swap_max" --argjson zram_max "$zram_max" \
                --argjson oom "$oomd" --argjson nproc "$nproc_n" --argjson top "${top_json:-[]}" \
                '{start:$start,end:$end,dur_s:$dur,trigger:$reason,host:$host,
                  psi_us:{mem_full:$mem_full,io_full:$io_full,cpu_some:$cpu_some},
                  mem_avail_min_mb:$ma_min,swap_used_max_kb:$swap_max,zram_memused_max_b:$zram_max,
                  oom_events:$oom,nproc:$nproc,top_procs:$top}')
            printf '%s\n' "$rec" >> "$elog"
            warn "episode END (${dur}s): mem.full=${fm}us io.full=${fio}us memmin=${ma_min}MB"
            local lc; lc=$(wc -l <"$elog" 2>/dev/null || echo 0)
            [ "$lc" -gt "$MAXEP" ] && { mv -- "$elog" "$elog.1" 2>/dev/null || true; }
            p_memf=$(_psi_total memory full); p_iof=$(_psi_total io full)
            oom_prev=$(_oom_count); t_prev=$(date +%s)
        else
            p_memf=$c_memf; p_iof=$c_iof; oom_prev=$oom_now; t_prev=$t_now
        fi
        [ "$once" = 1 ] && break
    done
    return 0
}

case "$cmd" in
    help|-h|--help) cmd_help ;;
    init)           cmd_init "$@" ;;
    install)        cmd_install "$@" ;;
    list)           cmd_list ;;
    doctor)         cmd_doctor ;;
    sync)           cmd_sync ;;
    snapshot)       cmd_snapshot ;;
    snapshots)      cmd_snapshots ;;
    restore)        cmd_restore "$@" ;;
    probe)          cmd_probe "$@" ;;
    watch)          cmd_watch "$@" ;;
    *) err "unknown command: $cmd"; cmd_help; exit 2 ;;
esac
