#!/data/data/com.termux/files/usr/bin/bash
# dev — tmux-managed proot guest workspace: named, auto-tiled panes in one view.
#
# Source of truth: <repo>/termux/bin/dev. termux/bootstrap.sh copies it to
# $PREFIX/bin/dev (copy, not symlink — /sdcard has no exec bit). Edit the repo
# copy, re-run termux/bootstrap.sh (or `install -m 0755 <repo>/termux/bin/dev
# $PREFIX/bin/dev`) to update.
#
# Layout choices:
#   - tmux server runs Termux-side (native): survives guest exits, pays no
#     ptrace tax, reattaches after an app-UI kill (`dev` again).
#   - one session = one split-screen view. Names address PANES (by pane
#     title): `dev a b c` ensures a tiled pane per name, all visible at once.
#     The session's default-command is a guest login, so every split lands in
#     the guest; hooks re-tile on every split and pane exit (auto-arrange).
#   - the bind makes the repo appear at /mnt/shared/... exactly like the VM.
#     Keep in sync with PD_BIND in termux/bootstrap.sh.

set -eu

usage() {
    cat <<'EOF'
dev — proot guest workspace: named, auto-tiled panes in one tmux view

  dev                   enter the workspace (split-screen by default:
                        DEV_PANES guest panes, 2 if unset)
  dev NAME [NAME...]    ensure a guest pane per NAME (matched by pane title,
                        created if missing), focus the first — all visible
                        at once. The NAME-set IS the session ('dev a b' -> view
                        'a-b'), so a different set in another Termux tab is an
                        independent view, and re-running the same set
                        reattaches it. Layout follows pane count: 2 = side-by-
                        side halves, 3 = first full left half + two stacked
                        right, 4+ = equal grid. A single NAME zooms that pane
                        full-screen so leftover panes from a previous session
                        don't clutter the view (they stay alive; Ctrl-b z to
                        unzoom and see them)
  dev -s SESSION ...    force a specific session name (overrides the
                        name-derived one); bare 'dev' uses session 'dev'

  (for PC-side sessions use the sibling command `devpc NAME...`: same tiling,
   but each pane is an auto-reconnecting ssh to the PC attaching that PC-side
   tmux session — `devpc -h` for details.)
  dev -p N              grow the view to N panes (overrides DEV_PANES;
                        grow-only, never kills panes)
  dev -c CMD [ARGS...]  one-off command inside the guest, no tmux: login
                        shell, aliases available (dev -c devenv doctor,
                        dev -c claudea), exit code propagates
  dev doctor            Termux-side health check (mitigation marker, snapshot
                        freshness, rootfs backup age, guest login, dev binary)
  dev backup            tar the proot rootfs to <repo>/backups/ (keeps 2) —
                        disaster recovery for uninstall/data-clear
  dev -l                list sessions and their panes
  dev -h                this help

('doctor' and 'backup' are reserved words, not usable as pane names.)

self-maintenance on every run: if the repo copy of this script differs from
the installed one it reinstalls itself, and if the newest devenv snapshot is
older than DEV_SNAPSHOT_MAX_AGE_DAYS (default 3, 0 = off) a background
`devenv snapshot` refreshes it (Termux notification on completion).

keys: tap a pane to focus it (mouse on), Ctrl-b z zoom/unzoom one pane (THE
phone gesture), Ctrl-b arrows move, Ctrl-b % / " extra splits (auto-login +
auto-tile), Ctrl-b d detach. Soft keyboard: taps go to tmux, so reopen it
with the KEYBOARD extra key or the left-edge-drawer KEYBOARD button.
scroll: PgUp enters copy-mode + pages up (PgUp/PgDn page, PgDn at bottom
exits); full-screen apps (Claude Code, less, vim) get raw PgUp. Selecting
text: a plain finger-drag selects WITHIN the active pane (tmux copy-mode).
Termux's long-press selection ignores panes (spans the whole screen) — zoom
the pane first (Ctrl-b z) if you need it.
EOF
}

login=(proot-distro login debian --bind /storage/emulated/0:/mnt/shared)

wake() { termux-wake-lock 2>/dev/null || true; }

valid_name() {
    case "$1" in *[!A-Za-z0-9_-]*|'') return 1 ;; *) return 0 ;; esac
}

# Command tmux runs for a pane named $1, per $mode (set during arg parsing):
#   guest (default) — a plain proot guest login (same as default-command).
#   pc              — log into the guest and run `sshbab $1`: a reconnecting
#                     ssh to the PC (Host ssh.babanin.de) that attaches, or
#                     creates, the PC-side tmux session $1, re-dialing if the
#                     tunnel drops.
# Names are pre-validated to [A-Za-z0-9_-], so they need no further quoting.
pane_command() {
    if [ "${mode:-guest}" = pc ]; then
        printf '%s -- bash -lc %s' "${login[*]}" "'sshbab $1'"
    else
        printf '%s' "${login[*]}"
    fi
}

# ---- self-maintenance ---------------------------------------------------------
# Termux is the primary runtime now: the guest both consumes AND produces the
# devenv snapshots, and `dev` keeps itself and the snapshot window fresh so
# neither needs remembering.

REPO="${DEVENV_REPO:-/storage/emulated/0/Sync/debian-env}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devenv"
MITIGATE_MARKER="${XDG_STATE_HOME:-$HOME/.local/state}/devenv-mitigate.done"

c_ok()   { printf '\033[32m[ ok ]\033[0m %s\n' "$*"; }
c_warn() { printf '\033[33m[warn]\033[0m %s\n' "$*" >&2; }
c_log()  { printf '\033[34m[dev ]\033[0m %s\n' "$*"; }

# Reinstall $PREFIX/bin/dev whenever the repo copy changed, then re-exec the
# new version with the original args. Kills the recurring "NOTE: reinstall
# needed" footgun — editing termux/bin/dev in the repo is enough.
self_update() {
    local src="$REPO/termux/bin/dev" inst="$PREFIX/bin/dev"
    # Keep the devpc sibling wrapper in sync too, so a plain `dev` run makes
    # `devpc` available (and current) without re-running termux/bootstrap.sh.
    local psrc="$REPO/termux/bin/devpc" pinst="$PREFIX/bin/devpc"
    if [ -f "$psrc" ] && ! cmp -s "$psrc" "$pinst" 2>/dev/null; then
        install -m 0755 "$psrc" "$pinst" 2>/dev/null && c_log "installed/updated devpc" \
            || c_warn "devpc install failed (left as-is)"
    fi
    [ -f "$src" ] || return 0
    cmp -s "$src" "$inst" 2>/dev/null && return 0
    install -m 0755 "$src" "$inst" || { c_warn "dev: self-update failed (left as-is)"; return 0; }
    c_log "self-updated from repo copy"
    case "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")" in
        "$inst") exec "$inst" "$@" ;;
    esac
}

# Age (days) of the newest complete snapshot version; 9999 if none.
# Globs expand in ascending name order (names are sortable UTC timestamps),
# so the last match is the newest.
snapshot_age_days() {
    local ts="" d base
    for d in "$REPO/snapshots"/*/; do
        base="${d%/}"; base="${base##*/}"
        case "$base" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9])
                [ -f "$d/meta" ] && ts="$base" ;;
        esac
    done
    [ -n "$ts" ] || { echo 9999; return 0; }
    local epoch
    epoch="$(date -u -d "${ts:0:4}-${ts:4:2}-${ts:6:2} ${ts:9:2}:${ts:11:2}:${ts:13:2} UTC" +%s 2>/dev/null)" \
        || { echo 9999; return 0; }
    echo $(( ( $(date +%s) - epoch ) / 86400 ))
}

# If the newest snapshot is older than DEV_SNAPSHOT_MAX_AGE_DAYS (default 3,
# 0 disables), refresh it in the background. Lock lives on Termux ext4 (the
# shared mount has no flock); a pid file inside detects stale locks.
maybe_snapshot() {
    [ -d "$REPO/snapshots" ] || return 0          # devenv not bootstrapped yet
    local max="${DEV_SNAPSHOT_MAX_AGE_DAYS:-3}"
    [ "$max" = 0 ] && return 0
    local age; age="$(snapshot_age_days)"
    [ "$age" -ge "$max" ] || return 0
    local lock="$STATE_DIR/snapshot.lock"
    mkdir -p "$STATE_DIR"
    if ! mkdir "$lock" 2>/dev/null; then
        local pid; pid="$(cat "$lock/pid" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
        rm -rf "$lock"
        mkdir "$lock" 2>/dev/null || return 0
    fi
    c_log "snapshot is ${age}d old — refreshing in background (log: $STATE_DIR/snapshot.log)"
    (
        trap '' HUP                                # survive tab close / detach
        echo "$BASHPID" > "$lock/pid"
        if "${login[@]}" -- bash -lc 'devenv snapshot' >"$STATE_DIR/snapshot.log" 2>&1; then
            termux-notification --title 'devenv: snapshot refreshed' \
                --content "previous was ${age}d old" 2>/dev/null || true
        else
            termux-notification --title 'devenv: snapshot FAILED' \
                --content "see $STATE_DIR/snapshot.log" 2>/dev/null || true
        fi
        rmdir "$lock" 2>/dev/null || true
    ) >/dev/null 2>&1 &
}

# ---- dev backup ----------------------------------------------------------------
# Whole-rootfs disaster recovery: proot rootfs + guest $HOME live in Termux app
# data and die on uninstall/data-clear; the devenv snapshots only carry dotfiles
# and creds. `proot-distro backup` is the only format its restore path
# guarantees (ownership zeroed, hard links materialized). Recovery:
#   proot-distro restore <repo>/backups/debian-<ts>.tar.gz
cmd_backup() {
    local force=0
    [ "${1:-}" = "--force" ] && force=1
    local dir="$REPO/backups"
    [ -d "$REPO" ] || { c_warn "repo not found at $REPO"; exit 1; }

    # A backup of a live container can produce a broken restore (mid-write
    # files); refuse while guest sessions run unless forced.
    if [ "$force" = 0 ]; then
        if command -v pgrep >/dev/null 2>&1; then
            if pgrep -f 'proot.*debian' >/dev/null 2>&1; then
                c_warn "guest sessions are running — exit them first (tmux kill-server), or: dev backup --force"
                exit 1
            fi
        elif tmux has-session 2>/dev/null; then
            c_warn "tmux sessions exist (cannot pgrep for proot) — tmux kill-server first, or: dev backup --force"
            exit 1
        fi
    fi

    wake
    mkdir -p "$dir"
    local ts out
    ts="$(date -u +%Y%m%d-%H%M%S)"
    out="$dir/debian-$ts.tar.gz"
    c_log "backing up rootfs -> $out (several GB, takes a while; phone plugged in?)"
    if ! proot-distro backup debian --output "$out"; then
        rm -f "$out"
        c_warn "backup failed"
        exit 1
    fi
    c_ok "backup done: $out ($(du -h "$out" 2>/dev/null | cut -f1))"

    # Keep the newest DEV_BACKUP_RETAIN (default 2). Glob order is ascending
    # timestamp, so prune from the front of the list.
    local keep="${DEV_BACKUP_RETAIN:-2}" f
    local -a backs=()
    for f in "$dir"/debian-*.tar.gz; do [ -e "$f" ] && backs+=("$f"); done
    local n=${#backs[@]} i=0
    while [ $(( n - i )) -gt "$keep" ]; do
        rm -f "${backs[$i]}"
        c_log "pruned old backup: $(basename "${backs[$i]}")"
        i=$((i+1))
    done
    c_log "restore on a fresh Termux: pkg install proot-distro && proot-distro restore <file>"
}

# Age (days) of the newest rootfs backup; 9999 if none.
backup_age_days() {
    local f="" g
    for g in "$REPO"/backups/debian-*.tar.gz; do [ -e "$g" ] && f="$g"; done
    [ -n "$f" ] || { echo 9999; return 0; }
    echo $(( ( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ) / 86400 ))
}

# ---- dev doctor ----------------------------------------------------------------
# Termux-side health check — the counterpart of the guest's `devenv doctor`.
cmd_doctor() {
    local fails=0

    if [ -d "$REPO" ]; then c_ok "repo: $REPO"; else c_warn "repo missing at $REPO (set DEVENV_REPO?)"; fails=$((fails+1)); fi

    if cmp -s "$REPO/termux/bin/dev" "$PREFIX/bin/dev" 2>/dev/null; then
        c_ok "dev binary current"
    else
        c_warn "dev binary differs from repo copy (self-update will fix on next plain run)"; fails=$((fails+1))
    fi

    if [ -f "$MITIGATE_MARKER" ]; then
        c_ok "phantom-killer mitigation marker: $(cat "$MITIGATE_MARKER")"
        c_log "  flag can silently reset on Android updates — after one, or on any signal-9, run: bash $REPO/termux/mitigate.sh --verify"
    else
        c_warn "mitigation never applied — run: bash $REPO/termux/mitigate.sh"; fails=$((fails+1))
    fi

    if grep -q 'KEYBOARD' "$HOME/.termux/termux.properties" 2>/dev/null; then
        c_ok "termux.properties: KEYBOARD extra key present"
    else
        c_warn "termux.properties missing KEYBOARD extra key (re-run termux/bootstrap.sh)"; fails=$((fails+1))
    fi

    if command -v termux-notification >/dev/null 2>&1; then
        c_ok "termux-api present"
    else
        c_warn "termux-api missing (notifications dead) — pkg install termux-api"; fails=$((fails+1))
    fi

    if "${login[@]}" -- true >/dev/null 2>&1; then
        c_ok "guest login works"
    else
        c_warn "guest login FAILED — re-run termux/bootstrap.sh"; fails=$((fails+1))
    fi

    local age max="${DEV_SNAPSHOT_MAX_AGE_DAYS:-3}"
    age="$(snapshot_age_days)"
    if [ "$age" = 9999 ]; then
        c_warn "no devenv snapshot yet (run: dev -c devenv snapshot)"; fails=$((fails+1))
    elif [ "$max" != 0 ] && [ "$age" -ge "$max" ]; then
        c_warn "newest snapshot is ${age}d old (auto-refresh runs on next plain 'dev')"
    else
        c_ok "snapshot fresh (${age}d old)"
    fi

    age="$(backup_age_days)"
    if [ "$age" = 9999 ]; then
        c_warn "no rootfs backup yet — run: dev backup"; fails=$((fails+1))
    elif [ "$age" -ge "${DEV_BACKUP_MAX_AGE_DAYS:-30}" ]; then
        c_warn "newest rootfs backup is ${age}d old — consider: dev backup"
    else
        c_ok "rootfs backup fresh (${age}d old)"
    fi

    local sess
    sess="$(tmux list-sessions 2>/dev/null || true)"
    if [ -n "$sess" ]; then
        printf '%s\n' "$sess" | sed 's/^/       tmux: /'
    else
        c_log "tmux: no server running"
    fi

    if [ "$fails" -eq 0 ]; then c_ok "doctor: all clear"; else c_warn "doctor: $fails issue(s)"; return 1; fi
}

# Keep the installed copy in sync with the repo before anything else.
self_update "$@"

# Local (guest) panes by default; the `devpc` wrapper sets DEV_MODE=pc to make
# every pane an auto-reconnecting ssh to the PC instead. Keeping this on an env
# flag (not a `dev pc` positional) means `dev` never special-cases a pane name.
mode="${DEV_MODE:-guest}"

# Subcommands (reserved words — not usable as pane names).
case "${1:-}" in
    doctor) cmd_doctor; exit ;;
    backup) shift; cmd_backup "$@"; exit ;;
esac

session=dev
session_explicit=0   # set by -s; suppresses name-derived session
panes=""        # explicit -p request; empty = default behavior
names=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage; exit 0 ;;
        -l|--list)
            tmux list-sessions 2>/dev/null || { echo "no sessions"; exit 0; }
            tmux list-panes -a -F '  #{session_name}: pane #{pane_index} [#{pane_title}]'
            exit 0 ;;
        -s)
            shift; session="${1:-}"; session_explicit=1
            valid_name "$session" || { echo "dev: -s needs a session name" >&2; exit 2; } ;;
        -p)
            shift
            case "${1:-}" in ''|*[!0-9]*) echo "dev: -p needs a pane count" >&2; exit 2 ;; esac
            panes="$1" ;;
        -c)
            shift
            [ $# -gt 0 ] || { usage >&2; exit 2; }
            # One-off in a guest login shell: -l pulls in .profile (PATH incl.
            # ~/.local/bin), -i makes .bashrc define the claude/claudea aliases.
            wake
            maybe_snapshot
            cmd="$(printf '%q ' "$@")"
            exec "${login[@]}" -- bash -lic "$cmd" ;;
        -*)
            echo "dev: unknown flag: $1" >&2; usage >&2; exit 2 ;;
        *)
            valid_name "$1" || { printf 'dev: bad pane name: %q\n' "$1" >&2; exit 2; }
            names+=("$1") ;;
    esac
    shift
done

# Auto-derive the session from the name-set so each set is its own view, and
# separate Termux tabs (`dev a b` vs `dev 1 2`) don't mirror the one shared
# session. Re-running the same names reattaches the same view. Explicit -s
# wins; bare `dev` and `-p` keep the default 'dev' session. Subshell isolates
# the IFS change; names are already restricted to [A-Za-z0-9_-], so the joined
# value is a valid tmux session name.
if [ "$session_explicit" = 0 ] && [ ${#names[@]} -gt 0 ]; then
    session="$(IFS=-; printf '%s' "${names[*]}")"
    # Namespace PC views so `devpc x y` (pc-x-y) never collides with a local
    # `dev x y` (x-y) view that addresses the same names.
    [ "$mode" = pc ] && session="pc-$session"
fi

# pc mode addresses PC-side sessions by name — there's nothing to do without
# at least one.
if [ "$mode" = pc ] && [ ${#names[@]} -eq 0 ]; then
    echo "devpc: needs at least one PC tmux session name (e.g. devpc work logs)" >&2
    exit 2
fi

wake
maybe_snapshot

# ---- ensure the session exists and is configured ------------------------------
# Targets use the bare session name: tmux resolves exact names first, and the
# '=' exact-match prefix is NOT accepted by set-option/set-hook on Termux's
# tmux 3.6b ("no such session: =dev") even though has-session tolerates it.
# Options/hooks are (re)applied to pre-existing sessions too, so sessions made
# by older versions pick up the behavior.
session_created=0
if ! tmux has-session -t "$session" 2>/dev/null; then
    # In pc mode the first pane must run sshbab for the first name, not a bare
    # guest login (the named-pane loop below only titles it, never re-splits).
    if [ "$mode" = pc ] && [ ${#names[@]} -gt 0 ]; then
        tmux new-session -d -s "$session" "$(pane_command "${names[0]}")"
    else
        tmux new-session -d -s "$session" "${login[*]}"
    fi
    session_created=1
fi
# New windows and splits log into the guest instead of a Termux shell...
tmux set-option -t "$session" default-command "${login[*]}"
# ...the window re-tiles itself whenever a pane appears or dies. Layout is
# pane-count-aware: 2 = side-by-side halves, 3 = first pane full left half +
# two stacked right (main-vertical), else equal grid (tiled). At hook time
# window_panes already reflects the new count for all three hooks (pane-exited
# fires after removal; kill-pane never fires pane-exited, hence the
# after-kill-pane hook too)...
retile="if-shell -F '#{==:#{window_panes},2}' 'select-layout even-horizontal' \"if-shell -F '#{==:#{window_panes},3}' 'select-layout main-vertical' 'select-layout tiled'\""
tmux set-hook -t "$session" after-split-window "$retile"
tmux set-hook -t "$session" pane-exited "$retile"
tmux set-hook -t "$session" after-kill-pane "$retile"
tmux set-option -w -t "$session" main-pane-width '50%'
# ...pane titles (the names) are visible on the borders and apps can't clobber
# them via OSC title escapes (Claude Code sets the terminal title; without this
# a re-run sees the name "missing" and splits a duplicate pane)...
tmux set-option -t "$session" pane-border-status top
tmux set-option -w -t "$session" allow-set-title off
# ...and taps focus panes (Termux sends taps as mouse clicks when mouse mode is
# on; reopen the soft keyboard with the KEYBOARD extra key or the
# left-edge-drawer KEYBOARD button, not by tapping).
tmux set-option -t "$session" mouse on
# tmux replaces the terminal's own scrollback, so a bare PageUp would fall
# through to the app (a shell prompt ignores it) and the PGUP extra key stops
# scrolling. Bind PageUp to enter copy-mode and page up — but only on the
# normal screen: full-screen apps on the alternate screen (Claude Code, less,
# vim) get the real PageUp. Inside copy-mode the native keys page up/down and
# -e exits at the bottom. bind-key is server-global; re-applying is harmless.
tmux bind-key -n PPage if-shell -F '#{alternate_on}' 'send-keys PPage' 'copy-mode -eu'

# ---- named panes ----------------------------------------------------------------
# split-window targeting the session hits the ACTIVE pane and inserts the new
# pane right after it — repeated splits come out in reverse visual order
# (a, c, b). Splitting the last pane appends instead, keeping argument order.
last_pane() { tmux list-panes -t "$session" -F '#{pane_id}' | tail -1; }

if [ ${#names[@]} -gt 0 ]; then
    # A freshly created session has one untitled pane — claim it for the first
    # name instead of splitting.
    if [ "$session_created" = 1 ]; then
        tmux select-pane -t "$session" -T "${names[0]}"
    fi
    for n in "${names[@]}"; do
        if ! tmux list-panes -t "$session" -F '#{pane_title}' | grep -qxF "$n"; then
            if [ "$mode" = pc ]; then
                id="$(tmux split-window -d -P -F '#{pane_id}' -t "$(last_pane)" "$(pane_command "$n")")"
            else
                id="$(tmux split-window -d -P -F '#{pane_id}' -t "$(last_pane)")"
            fi
            tmux select-pane -t "$id" -T "$n"
        fi
    done

    # ---- prune foreign panes --------------------------------------------------
    # A multi-name view (`dev x y` / `devpc x y`) must show EXACTLY x y. Any pane
    # whose title isn't one of the requested names is stray — a leftover from an
    # earlier/interrupted run, or a manual Ctrl-b % split that picked up a
    # clobbered title — and would otherwise linger forever (the named loop above
    # only adds, never removes) and push the layout into an extra tile. Drop it.
    # Scoped to THIS session, so panes in other Termux tabs (each tab attaches
    # its own name-derived session) are never touched — different name-set,
    # different session, not listed here. The named loop guarantees a pane per
    # name still exists, so this never empties the session. Single-name views are
    # exempt: they keep their zoom-one-pane-leave-the-rest-alive behavior below.
    if [ ${#names[@]} -ge 2 ]; then
        while read -r _pid _ptitle; do
            for n in "${names[@]}"; do [ "$_ptitle" = "$n" ] && continue 2; done
            tmux kill-pane -t "$_pid" 2>/dev/null || true
        done < <(tmux list-panes -t "$session" -F '#{pane_id} #{pane_title}')
    fi
fi

# ---- pane count -------------------------------------------------------------------
# Bare `dev` defaults to a DEV_PANES-way split (2 if unset); with names the
# names dictate the panes unless -p asks for more. Grow-only.
target="$panes"
if [ -z "$target" ] && [ ${#names[@]} -eq 0 ]; then
    target="${DEV_PANES:-2}"
    case "$target" in *[!0-9]*|'') echo "dev: DEV_PANES must be a number (got: $target)" >&2; exit 2 ;; esac
fi
if [ -n "$target" ]; then
    while [ "$(tmux list-panes -t "$session" | wc -l)" -lt "$target" ]; do
        tmux split-window -d -t "$(last_pane)"
    done
fi
# Same count-aware layout as the hooks, for panes that already existed.
case "$(tmux list-panes -t "$session" | wc -l)" in
    2) tmux select-layout -t "$session" even-horizontal ;;
    3) tmux select-layout -t "$session" main-vertical ;;
    *) tmux select-layout -t "$session" tiled ;;
esac

# ---- enter -------------------------------------------------------------------------
# Focus the first named pane, then attach (or switch, when already inside tmux).
if [ ${#names[@]} -gt 0 ]; then
    pid="$(tmux list-panes -t "$session" -F '#{pane_id} #{pane_title}' \
        | awk -v t="${names[0]}" '$2==t{print $1; exit}')"
    if [ -n "$pid" ]; then
        tmux select-window -t "$pid"
        tmux select-pane -t "$pid"
        # A single name collapses the view to just that pane: zoom it so any
        # leftover panes from a previous session don't show as extra tiles.
        # Non-destructive — the others stay alive (Ctrl-b z to unzoom). The
        # select-layout above already cleared any stale zoom, so multiple
        # names keep their tiled view. Skip when there's only one pane total
        # (nothing to hide; -Z would needlessly toggle the zoom flag).
        if [ ${#names[@]} -eq 1 ] && [ "$(tmux list-panes -t "$session" | wc -l)" -gt 1 ]; then
            tmux resize-pane -Z -t "$pid"
        fi
    fi
fi
if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$session"
fi
exec tmux attach-session -t "$session"
